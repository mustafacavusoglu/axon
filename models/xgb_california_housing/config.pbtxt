# Triton Inference Server model configuration
# Auto-generated — model: xgb_california_housing

name: "xgb_california_housing"
platform: "onnxruntime_onnx"
max_batch_size: 8

# ── Input: 8 features ──────────────────────
input [
  {
    name: "median_income"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "house_age"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "avg_rooms"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "avg_bedrooms"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "population"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "avg_occupancy"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "latitude"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "longitude"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

# ── Output ─────────────────────────────────────────────
output [
    {
      name: "output"
      data_type: TYPE_FP32
      dims: [ 1 ]
    }
]

# ── Dynamic batching ───────────────────────────────────
dynamic_batching {
  max_queue_delay_microseconds: 100
}

# ── Instance group (CPU-only) ──────────────────────────
instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]
